# Service Configuration
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# Upstox OAuth 2.0 Credentials (Free Broker API - Get from https://api.upstox.com)
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback

# Dhan API Credentials (Free Broker API - Get from Dhan Web Portal)
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here